{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chaoanouvongpark",
  "main": "./src/worker.ts",
  "compatibility_date": "2025-04-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
