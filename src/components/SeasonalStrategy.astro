---
import type { Lang } from '../i18n/ui';

interface Props { messages: any; lang: Lang; }
const { messages } = Astro.props;
const s = messages.season;
---

<section id="season" class="bg-ivory py-20">
  <div class="mx-auto max-w-7xl px-5">
    <p class="font-hand text-2xl text-gold">{s.label}</p>
    <h2 class="mt-1 font-display text-3xl font-bold text-ink md:text-4xl">{s.heading}</h2>
    <p class="mt-3 max-w-3xl text-ink/70">{s.lead}</p>

    <div class="mt-10 overflow-x-auto rounded-2xl border border-teak/15 bg-white shadow-sm">
      <table class="w-full min-w-[760px] border-collapse text-left text-sm">
        <thead class="bg-teakDeep text-ivory">
          <tr>
            {s.cols.map((c: string) => (
              <th class="px-4 py-3 font-display font-semibold first:rounded-tl-2xl last:rounded-tr-2xl">{c}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {s.rows.map((r: any, i: number) => (
            <tr class={i % 2 ? 'bg-ivory/60' : 'bg-white'}>
              <td class="px-4 py-3 font-display font-semibold text-teak">{r.q}</td>
              <td class="px-4 py-3 text-ink/80">{r.weather}</td>
              <td class="px-4 py-3 text-ink/80">{r.crowds}</td>
              <td class="px-4 py-3 text-ink/80">{r.pack}</td>
              <td class="px-4 py-3 text-ink/80">{r.tip}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="mt-5 text-xs text-ink/50">{s.source}</p>
  </div>
</section>
