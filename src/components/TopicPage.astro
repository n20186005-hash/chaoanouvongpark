---
import { siteConfig } from '../config';
import { TOPICS, type TopicContent, type TopicSlug } from '../i18n/topics';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  content: TopicContent;
  slug: TopicSlug;
  messages: Record<string, any>;
}
const { lang, content, slug, messages } = Astro.props;

const galleryImgs = content.gallery.map(
  (i) => `/gallery/${siteConfig.galleryPrefix}${i}.jpg`,
);

const related = content.related
  .map((r) => ({ slug: r, title: TOPICS[lang][r].title }))
  .filter((r) => r.slug !== slug);

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: content.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="py-16 bg-ivory text-ink">
  <div class="max-w-4xl mx-auto px-5">
    <a href={`/${lang}/`} class="text-gold hover:underline text-sm">← {messages.header.home}</a>
    <h1 class="mt-3 font-display font-semibold text-3xl md:text-5xl text-teak">{content.title}</h1>
    <p class="mt-4 text-lg text-ink/80 leading-relaxed">{content.intro}</p>

    {messages.guide?.verifiedNote && (
      <p class="mt-3 max-w-3xl text-xs text-ink/55 border-l-2 border-gold/40 pl-3">{messages.guide.verifiedNote}</p>
    )}

    {content.sections.map((s) => (
      <div class="mt-10">
        <h2 class="font-display text-2xl text-teak border-l-4 border-gold pl-3">{s.title}</h2>
        <p class="mt-3 text-ink/80 leading-relaxed">{s.text}</p>
      </div>
    ))}

    {galleryImgs.length > 0 && (
      <div class="mt-12">
        <h2 class="font-display text-2xl text-teak mb-4">{messages.gallery.heading}</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
          {galleryImgs.map((src, i) => (
            <img
              src={src}
              alt={`${content.title} — ${messages.gallery.alts[i % messages.gallery.alts.length] || content.title}`}
              loading="lazy"
              class="rounded-xl border border-gold/20 object-cover w-full h-44"
            />
          ))}
        </div>
      </div>
    )}

    {content.faqs.length > 0 && (
      <div class="mt-12">
        <h2 class="font-display text-2xl text-teak mb-5">{messages.guide.faqTitle}</h2>
        <div class="space-y-3">
          {content.faqs.map((f) => (
            <details class="group rounded-xl border border-gold/25 bg-white/50 p-4">
              <summary class="cursor-pointer font-medium text-teak flex justify-between items-center">
                {f.q}
                <span class="text-gold transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="mt-2 text-sm text-ink/75">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    )}

    {related.length > 0 && (
      <div class="mt-12">
        <h2 class="font-display text-2xl text-teak mb-4">{messages.footer.navTitle}</h2>
        <div class="grid sm:grid-cols-3 gap-4">
          {related.map((r) => (
            <a
              href={`/${lang}/${r.slug}/`}
              class="group rounded-2xl border border-gold/25 bg-white/50 p-5 hover:border-gold hover:shadow-md transition"
            >
              <div class="font-display text-teak font-semibold text-lg">{r.title}</div>
              <span class="mt-3 inline-block text-sm text-gold group-hover:text-goldBright">→ {messages.header.home}</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
