---
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = {
  en: { eyebrow: 'Explore nearby', title: 'More to see around the Mekong', description: 'Six starting points for a riverside afternoon, from royal-era temples to the monument, sunset promenade and night market. Follow each card for its own visitor guide.', cta: 'Read the place guide', all: 'Explore all nearby stops' },
  lo: { eyebrow: 'ທ່ຽວໃກ້ຄຽງ', title: 'ຄົ້ນພົບສະຖານທີ່ໃກ້ແມ່ນ້ຳຂອງ', description: 'ຫົກຈຸດແນະນຳສຳລັບທ່ຽວວຽງຈັນຕອນບ່າຍ: ວັດເກົ່າ, ອານຸສາວະລີ, ທາງຍ່າງຊົມຕາເວັນຕົກ ແລະ ຕະຫຼາດກາງຄືນ.', cta: 'ອ່ານຄູ່ມືສະຖານທີ່', all: 'ເບິ່ງສະຖານທີ່ໃກ້ຄຽງທັງໝົດ' },
  zh: { eyebrow: '探索周边', title: '湄公河畔还有这些景点', description: '先从六个不同的游览主题出发：古寺、城市地标、国王雕像、河滨日落与夜市。点击卡片可阅读各自的实用指南。', cta: '阅读景点指南', all: '查看完整周边游览攻略' },
}[lang];
const places = [
  { image: '/gallery/nearby-wat-si-saket.jpg', slug: 'wat-si-saket', name: { en: 'Wat Si Saket', lo: 'ວັດສີສະເກດ', zh: '西萨格寺' }[lang] },
  { image: '/gallery/nearby-ho-phra-keo.jpg', slug: 'ho-phra-keo', name: { en: 'Ho Phra Keo', lo: 'ຫໍພະແກ້ວ', zh: '玉佛寺' }[lang] },
  { image: '/gallery/nearby-presidential-palace.jpg', slug: 'presidential-palace', name: { en: 'Presidential Palace', lo: 'ຫໍຄຳປະທານປະເທດ', zh: '主席府' }[lang] },
  { image: '/gallery/chao-anouvong-park-1.jpg', slug: 'chao-anouvong-statue', name: { en: 'King Anouvong Statue', lo: 'ຮູບປັ້ນພະເຈົ້າອະນຸວົງ', zh: '昭阿奴翁国王雕像' }[lang] },
  { image: '/gallery/nearby-night-market.jpg', slug: 'night-market', name: { en: 'Vientiane Night Market', lo: 'ຕະຫຼາດກາງຄືນວຽງຈັນ', zh: '万象夜市' }[lang] },
  { image: '/gallery/chao-anouvong-park-8.jpg', slug: 'mekong-sunset', name: { en: 'Mekong Sunset Walk', lo: 'ຍ່າງຊົມຕາເວັນຕົກແຄມຂອງ', zh: '湄公河日落步道' }[lang] },
];
---
<section id="nearby" class="py-16 bg-ivory text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl">{copy.eyebrow}</p>
    <h2 class="font-display text-teak text-3xl md:text-4xl font-semibold mt-2">{copy.title}</h2>
    <p class="mt-4 text-ink/75 max-w-3xl">{copy.description}</p>
    <div class="mt-8 grid md:grid-cols-3 gap-5">
      {places.map((place) => (
        <a href={`/${lang}/${place.slug}/`} class="group rounded-2xl overflow-hidden bg-white border border-gold/25 hover:shadow-lg transition">
          <img src={place.image} alt={place.name} class="h-52 w-full object-cover" loading="lazy" />
          <div class="p-5"><h3 class="font-display text-teak font-semibold text-xl">{place.name}</h3><span class="mt-3 inline-block text-sm text-gold">{copy.cta} →</span></div>
        </a>
      ))}
    </div>
    <a href={`/${lang}/nearby-attractions/`} class="inline-flex mt-8 rounded-full border border-teak/30 px-6 py-3 text-sm font-semibold text-teak hover:bg-teak hover:text-ivory transition-colors">{copy.all} →</a>
  </div>
</section>
