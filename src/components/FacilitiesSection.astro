---
import type { Lang } from '../i18n/ui';

interface Props { messages: any; lang: Lang; }
const { messages } = Astro.props;
const f = messages.facilities;
---

<section id="facilities" class="bg-ivory py-20">
  <div class="mx-auto max-w-7xl px-5">
    <p class="font-hand text-2xl text-gold">{f.label}</p>
    <h2 class="mt-1 font-display text-3xl font-bold text-ink md:text-4xl">{f.heading}</h2>
    <p class="mt-3 max-w-2xl text-ink/70">{f.lead}</p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {f.categories.map((c: any) => (
        <article class="rounded-2xl border border-teak/15 bg-white p-6 shadow-sm">
          <div class="flex items-center gap-3">
            <span class="text-3xl">{c.icon}</span>
            <h3 class="font-display text-lg font-semibold text-teak">{c.name}</h3>
          </div>
          <p class="mt-2 text-sm text-ink/70">{c.desc}</p>
        </article>
      ))}
    </div>

    <p class="mt-8 text-sm text-ink/50">{f.note}</p>
  </div>
</section>
