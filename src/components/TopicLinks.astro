---
import { TOPICS, TOPIC_SLUGS } from '../i18n/topics';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const items = TOPIC_SLUGS.map((slug) => ({
  slug,
  title: TOPICS[lang][slug].title,
  description: TOPICS[lang][slug].description,
}));
---

<section class="py-16 bg-teakDeep text-ivory">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">Explore</p>
    <h2 class="font-display font-semibold text-3xl md:text-4xl text-ivory mt-2">Guides & topics</h2>
    <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {items.map((it) => (
        <a
          href={`/${lang}/${it.slug}/`}
          class="group rounded-2xl border border-gold/25 bg-teak/50 p-5 hover:border-gold hover:shadow-md transition"
        >
          <div class="font-display text-ivory font-semibold text-lg leading-snug">{it.title}</div>
          <p class="mt-2 text-sm text-ivory/70 leading-relaxed line-clamp-4">{it.description}</p>
          <span class="mt-3 inline-block text-sm text-gold group-hover:text-goldBright">→ {lang === 'lo' ? 'ອ່ານຕໍ່' : lang === 'zh' ? '阅读更多' : 'Read more'}</span>
        </a>
      ))}
    </div>
  </div>
</section>
