---
import type { Lang } from '../i18n/ui';

interface Props { messages: any; lang: Lang; }
const { messages } = Astro.props;
const r = messages.responsibility;
---

<section id="responsibility" class="bg-ivory py-20">
  <div class="mx-auto max-w-7xl px-5">
    <p class="font-hand text-2xl text-gold">{r.label}</p>
    <h2 class="mt-1 font-display text-3xl font-bold text-ink md:text-4xl">{r.heading}</h2>
    <p class="mt-3 max-w-3xl text-ink/70">{r.lead}</p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <article class="rounded-2xl border border-teak/15 bg-white p-6 shadow-sm">
        <h3 class="font-display text-lg font-semibold text-teak">{r.riverTitle}</h3>
        <p class="mt-2 text-sm text-ink/75">{r.river}</p>
      </article>

      <article class="rounded-2xl border border-teak/15 bg-white p-6 shadow-sm">
        <h3 class="font-display text-lg font-semibold text-teak">{r.wildlifeTitle}</h3>
        <ul class="mt-2 space-y-1 text-sm text-ink/75">
          {r.wildlife.map((x: string) => (
            <li class="flex gap-2"><span class="text-gold">•</span><span>{x}</span></li>
          ))}
        </ul>
      </article>

      <article class="rounded-2xl border border-teak/15 bg-white p-6 shadow-sm">
        <h3 class="font-display text-lg font-semibold text-teak">{r.zeroWasteTitle}</h3>
        <ul class="mt-2 space-y-1 text-sm text-ink/75">
          {r.zeroWaste.map((x: string) => (
            <li class="flex gap-2"><span class="text-gold">•</span><span>{x}</span></li>
          ))}
        </ul>
      </article>

      <article class="rounded-2xl border border-teak/15 bg-white p-6 shadow-sm">
        <h3 class="font-display text-lg font-semibold text-teak">{r.safetyTitle}</h3>
        <ul class="mt-2 space-y-1 text-sm text-ink/75">
          {r.safety.map((x: string) => (
            <li class="flex gap-2"><span class="text-gold">•</span><span>{x}</span></li>
          ))}
        </ul>
      </article>
    </div>

    <article class="mt-6 rounded-2xl border border-gold/30 bg-gold/10 p-6">
      <h3 class="font-display text-lg font-semibold text-teak">{r.cultureTitle}</h3>
      <p class="mt-2 text-sm text-ink/75">{r.culture}</p>
    </article>
  </div>
</section>
