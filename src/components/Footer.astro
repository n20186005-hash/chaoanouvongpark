---
import { siteConfig } from '../config';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { lang, messages } = Astro.props;
const legalLine = {
  zh: '本网站是一个独立的旅游信息项目。我们与任何政府机构或官方组织均无关联。',
  en: 'This website is an independent travel information project. We are not affiliated with any government agency or official organization.',
  lo: 'ເວັບໄຊນີ້ເປັນໂຄງການຂໍ້ມູນທ່ອງທ່ຽວອິດສະຫຼະ ແລະ ບໍ່ມີຄວາມກ່ຽວຂ້ອງກັບໜ່ວຍງານລັດ ຫຼື ອົງການທາງການ.',
}[lang];
const rights = { zh: '版權所有', en: 'All rights reserved', lo: 'ສະຫງວນລິຂະສິດ' }[lang];
---

<footer class="bg-teakDeep text-ivory py-8">
  <div class="max-w-7xl mx-auto px-5">
    <div class="flex flex-col md:flex-row md:justify-between gap-6">
      <div class="text-xs text-ivory/65 leading-relaxed space-y-2">
        <p>© {new Date().getFullYear()} {siteConfig.name[lang]} · {rights}</p>
        <p>{legalLine}</p>
      </div>
      <nav aria-label="Legal" class="flex flex-wrap md:justify-end items-start gap-x-5 gap-y-2 text-xs">
        <a href={`/${lang}/privacy-policy/`} class="text-ivory/75 hover:text-goldBright">{messages.footer.privacy}</a>
        <a href={`/${lang}/terms-of-service/`} class="text-ivory/75 hover:text-goldBright">{messages.footer.terms}</a>
        <a href={`/${lang}/cookie-settings/`} class="text-ivory/75 hover:text-goldBright">{messages.footer.cookies}</a>
      </nav>
    </div>
  </div>
</footer>
