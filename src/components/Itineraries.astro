---
import type { Lang } from '../i18n/ui';

interface Props { messages: any; lang: Lang; }
const { messages } = Astro.props;
const it = messages.itineraries;
---

<section id="itineraries" class="bg-teakDeep py-20 text-ivory">
  <div class="mx-auto max-w-7xl px-5">
    <p class="font-hand text-2xl text-gold">{it.label}</p>
    <h2 class="mt-1 font-display text-3xl font-bold md:text-4xl">{it.heading}</h2>
    <p class="mt-3 max-w-2xl text-ivory/70">{it.lead}</p>

    <h3 class="mt-10 font-display text-xl font-semibold text-gold">{it.audiencesTitle}</h3>
    <div class="mt-4 grid gap-5 md:grid-cols-3">
      {it.audiences.map((a: any) => (
        <article class="rounded-2xl border border-ivory/15 bg-ivory/5 p-6">
          <div class="flex items-center gap-3">
            <span class="text-3xl">{a.icon}</span>
            <h4 class="font-display text-lg font-semibold">{a.name}</h4>
          </div>
          <p class="mt-2 text-sm text-ivory/70">{a.desc}</p>
          <ul class="mt-3 space-y-1 text-sm text-ivory/85">
            {a.items.map((x: string) => (
              <li class="flex gap-2"><span class="text-gold">✓</span><span>{x}</span></li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <h3 class="mt-10 font-display text-xl font-semibold text-gold">{it.plansTitle}</h3>
    <div class="mt-4 grid gap-5 md:grid-cols-2">
      {it.plans.map((p: any) => (
        <article class="rounded-2xl border border-ivory/15 bg-ivory/5 p-6">
          <div class="flex items-center gap-3">
            <span class="text-3xl">{p.icon}</span>
            <h4 class="font-display text-lg font-semibold">{p.name}</h4>
          </div>
          <p class="mt-2 text-sm text-ivory/70">{p.desc}</p>
          <ol class="mt-3 space-y-2 text-sm text-ivory/85">
            {p.steps.map((s: string) => (
              <li class="flex gap-2"><span class="mt-1 text-gold">›</span><span>{s}</span></li>
            ))}
          </ol>
        </article>
      ))}
    </div>
  </div>
</section>
