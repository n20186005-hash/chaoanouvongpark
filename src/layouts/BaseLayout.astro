---
import '../styles/global.css';
import { siteConfig } from '../config';
import { htmlLang, languagesList, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  messages: Record<string, any>;
}
const { lang, title, description, messages } = Astro.props;
const canonical = `${siteConfig.domain}/${lang}/`;

const faqs = (messages && messages.guide && messages.guide.faqs) ? messages.guide.faqs : [];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': ['TouristAttraction', 'Park'],
    '@id': `${siteConfig.domain}/#attraction`,
    name: siteConfig.name[lang],
    alternateName: [
      ...languagesList.filter((l) => l !== lang).map((l) => siteConfig.name[l]),
      siteConfig.shortName,
      `${siteConfig.city} ${siteConfig.name.en}`,
    ].filter((v, i, a) => a.indexOf(v) === i),
    description,
    image: [`${siteConfig.domain}/gallery/${siteConfig.galleryPrefix}1.jpg`],
    url: canonical,
    isAccessibleForFree: true,
    publicAccess: true,
    hasMap: siteConfig.mapsUrl,
    address: {
      '@type': 'PostalAddress',
      streetAddress: siteConfig.address,
      addressLocality: siteConfig.city,
      addressRegion: siteConfig.stateProvince,
      postalCode: siteConfig.postalCode,
      addressCountry: 'LA',
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: siteConfig.coords.lat,
      longitude: siteConfig.coords.lng,
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: siteConfig.rating,
      reviewCount: siteConfig.reviewCount.replace(/,/g, ''),
    },
    openingHoursSpecification: [
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '24:00',
      },
    ],
    sameAs: siteConfig.sameAs,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href={`/gallery/${siteConfig.galleryPrefix}1.jpg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.siteName[lang]} />
    <meta property="og:locale" content={htmlLang[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteConfig.domain}/gallery/${siteConfig.galleryPrefix}1.jpg`} />
    <meta property="og:image:alt" content={`${siteConfig.name[lang]} — ${siteConfig.city}, ${siteConfig.country}`} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1f1a17" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    {languagesList.map((l) => (
      <link rel="alternate" hreflang={htmlLang[l]} href={`${siteConfig.domain}/${l}/`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteConfig.domain}/lo/`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Trirong:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Sarabun:wght@300;400;500;600;700&family=Charm:wght@400;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
  </head>
  <body class="grain">
    <slot />

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
